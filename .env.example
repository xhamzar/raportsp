# GEMINI_API_KEY: Required for optional Gemini AI educational assistant calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLite local database file path (offline-first storage)
DATABASE_PATH="./data/sekolahkita.db"

# Server-side session signing secret (falls back to secure runtime random bytes if unset)
SESSION_SECRET=

# Optional administrator bootstrap passcode for initial setup
ADMIN_BOOTSTRAP_PASSCODE=
